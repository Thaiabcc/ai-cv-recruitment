APP_NAME=AI CV Recruitment
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_cv_recruitment
DB_USER=root
DB_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
